# Copy to .env.local and fill in. Names only here; never commit real values.

# sandbox | testnet | mainnet
VITE_NEAR_NETWORK=testnet
# JSON-RPC endpoint for the network above. near-api-js docs use https://test.rpc.fastnear.com for
# testnet (not verified from the build environment).
VITE_NEAR_RPC_URL=
# The vault this page approves payments for. Links for any other vault are refused.
VITE_VAULT_ID=
# Optional transaction explorer URL with {hash} placeholder. Defaults to nearblocks for
# testnet/mainnet, none for sandbox.
VITE_EXPLORER_TX_URL=
# Optional account explorer URL with {account} placeholder (dashboard links). Defaults to nearblocks.
VITE_EXPLORER_ACCOUNT_URL=
# Optional: where the Security Lab report is served (default security-report.json next to the page,
# built by scripts/security-report.sh or the CI security-report job). Relative path or https URL.
VITE_SECURITY_REPORT_URL=
# sandbox only: local dev signer (apps/web/dev/dev-signer.ts). Refused on testnet/mainnet.
VITE_DEV_SIGNER_URL=
